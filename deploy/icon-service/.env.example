# Copy to .env; replace these examples with your actual local installation.
# No passwords/tokens belong here. Keep this directory outside a public web root.
OPENLIST_ICONS_IMAGE=openlist-icons:local
OPENLIST_ICONS_DATA=/srv/openlist-icons/uploads
OPENLIST_ICONS_ROOT=/var/lib/openlist-icons
OPENLIST_ICONS_BACKEND=http://127.0.0.1:5244
OPENLIST_ICONS_ORIGIN=https://openlist.example
