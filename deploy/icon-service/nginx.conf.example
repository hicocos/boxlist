# Include INSIDE the existing HTTPS server block for your OpenList site.
# Host nginx shares host loopback with the Linux host-network sidecar.
# Audit existing regex locations: ^~ prevents regex overrides for this prefix.
location ^~ /icon-library/ {
    client_max_body_size 5m;
    client_body_timeout 25s;
    proxy_http_version 1.1;
    # No URI suffix: preserve the entire /icon-library/... path exactly.
    proxy_pass http://127.0.0.1:5235;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Origin $http_origin;
    proxy_set_header Connection "close";
    proxy_connect_timeout 3s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    proxy_request_buffering on;
    proxy_cache off;
    proxy_intercept_errors off;
    # Neutralize any inherited error_page ... /index.html fallback.
    error_page 400 401 403 404 405 408 409 410 411 413 414 415 417 422 429 431 500 501 502 503 504 505 507 = @openlist_icons_proxy_error;
}
# Only nginx-generated/proxy errors use this named location;
# upstream JSON errors pass through because proxy_intercept_errors is off.
location @openlist_icons_proxy_error {
    internal;
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    return 503 '{"code":503,"message":"图标代理暂不可用或请求被代理拒绝"}';
}
